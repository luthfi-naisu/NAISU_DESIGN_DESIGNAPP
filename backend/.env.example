# App
TEMP_DIR=
MAX_SEGMENT_DURATION=30
DEFAULT_GIF_WIDTH=480
DEFAULT_GIF_FPS=12
ALPHA_THRESHOLD=128
REMBG_MODEL=birefnet-general

# Shutterstock
SHUTTERSTOCK_CLIENT_ID=
SHUTTERSTOCK_CLIENT_SECRET=
SHUTTERSTOCK_API_TOKEN=
SHUTTERSTOCK_SUBSCRIPTION_ID=
SHUTTERSTOCK_LICENSE_SIZE=hd

# SiliconFlow
SILICONFLOW_API_KEY=
SILICONFLOW_MODEL=Wan-AI/Wan2.1-I2V-14B-720P-Turbo

# Replicate
REPLICATE_API_TOKEN=

# ComfyUI (optional)
COMFYUI_ENABLED=false
COMFYUI_HOST=http://127.0.0.1:8188
COMFYUI_WORKFLOW_PATH=

# CORS
CORS_ORIGINS=http://localhost:3000
